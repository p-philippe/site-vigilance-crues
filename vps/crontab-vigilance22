# Crontab Vigilance 22 — VPS Ubuntu
# Installer avec : crontab -e  (puis coller ces lignes)
# ou : crontab /chemin/vers/crontab-vigilance22

SHELL=/bin/bash
MAILTO=""
VENV=/home/user/vigilance22-maintenance/venv  # Adapter le user
MAINT=/home/user/vigilance22-maintenance
APP=/var/www/vigilance22

# ── MAINTENANCE HEBDOMADAIRE ──────────────────────────────
# Mise à jour snapshot SHOM chaque lundi à 6h00
# → Rafraîchit les horaires de marées embarqués dans index.html
0 6 * * 1 cd ${MAINT} && ${VENV}/bin/python3 update_shom.py && cp index.html ${APP}/index.html >> /var/log/vigilance22-shom.log 2>&1

# ── SURVEILLANCE VIGICRUES (toutes les 15 min) ────────────
# Vérifie si une vigilance ≥ Orange est active sur le 22
# Si oui, lance automatiquement la recalibration propagation
*/15 * * * * ${VENV}/bin/python3 ${MAINT}/check_vigi.py >> /var/log/vigilance22-vigi.log 2>&1

# ── LOGS : rotation mensuelle ─────────────────────────────
0 0 1 * * truncate -s 0 /var/log/vigilance22-shom.log /var/log/vigilance22-vigi.log
